# This repo tracks skill folders directly. Do not ignore skill directories —
# `npx skills add mwasobaddy/skills` discovers them from the repo root, so they
# have to be committed here.

# Never commit secrets, anywhere in the tree.
.env
.env.*
*.key
*.pem

# Nested repos would break discovery and confuse tooling.
**/.git

# OS noise
.DS_Store

# Never commit local eval output (regenerate with scripts/run-trigger-eval.sh).
**/evals/*.report.json
**/evals/last-run*.json